# HubEnts - Variables de Entorno
# Copiar este archivo a .env.local y completar los valores

# ===========================================
# CLERK (Autenticación) - Próximamente
# ===========================================
# Obtener en: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# URLs de redirección (opcional)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ===========================================
# NEON (Base de Datos PostgreSQL) - Próximamente
# ===========================================
# Obtener en: https://console.neon.tech
DATABASE_URL=

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
