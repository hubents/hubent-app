# HubEnts - Variables de Entorno
# Copiar este archivo a .env.local y completar los valores

# ===========================================
# NEXTAUTH (Autenticación)
# ===========================================
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# ===========================================
# RESEND (Magic Link Email) - REQUERIDO
# ===========================================
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=HubEnts <noreply@hubents.com>

# ===========================================
# OAUTH (Opcional - para login con Google/GitHub)
# ===========================================
# Google OAuth - Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - Obtener en: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# NEON (Base de Datos PostgreSQL)
# ===========================================
# Obtener en: https://console.neon.tech
DATABASE_URL=

# ===========================================
# Cloudflare R2 Storage
# ===========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hubents-uploads
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ===========================================
# STRIPE (Pagos)
# ===========================================
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Para Stripe Connect (OAuth)
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
