# HubEnts - Variables de Entorno
# Copiar este archivo a .env.local y completar los valores

# ===========================================
# NEXTAUTH (Autenticación)
# ===========================================
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# ===========================================
# RESEND (Magic Link Email) - REQUERIDO
# ===========================================
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=HubEnts <noreply@hubents.com>

# ===========================================
# OAUTH (Opcional - para login con Google/GitHub)
# ===========================================
# Google OAuth - Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - Obtener en: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# NEON (Base de Datos PostgreSQL)
# ===========================================
# Obtener en: https://console.neon.tech
DATABASE_URL=

# ===========================================
# VERCEL BLOB (Storage para archivos)
# ===========================================
# Obtener en: https://vercel.com/dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=

# ===========================================
# APP CONFIG
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
